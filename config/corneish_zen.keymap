#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10    // default: 10

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;
    };
};

/ {
    behaviors {
        td_2_4: tap_dance_layers_2_4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 2>, <&mo 4>;
        };

        td_1_3: tap_dance_layers_1_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 1>, <&mo 3>;
        };

        td0: tab_esc {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp TAB>, <&kp ESC>;
        };

        td1: alt_globe {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RALT>, <&kp GLOBE>;
        };

        td2: esc_rshift {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&kp RSHIFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
// --------------------------------------------------------------------------------
// |  td0 |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  ENT |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
//                    | GUI | td_1_3 | SPC |   | ENT | td_2_4  | ALT |
            bindings = <
&td0     &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
&kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp RET
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &td2
               &kp LGUI &td_1_3 &kp SPACE   &kp SPACE &td_2_4 &td1
            >;
        };

        lower_layer {
            display-name = "NUM_NAV";
// -----------------------------------------------------------------------------------------
// |  ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// |      | APP |  HM | PG^ | PGv |  ED |   | LFT | DWN |  UP | RGT |     | DEL  |
// |  F1  |  F2 |  F3 |  F4 |  F5 |  F6 |   | F7  | F8  | F9  | F10 |F11  | F12  |
//                    | GUI |     | SPC |   | SPC |     | ALT |
            bindings = <
&kp ESC    &kp N1       &kp N2  &kp N3  &kp N4  &kp N5   &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
&trans  &kp K_APP  &kp HOME  &kp PG_DN  &kp PG_UP &kp END   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &kp DEL
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6         &kp F7   &kp F8   &kp F9 &kp F10 &kp F11 &kp F12
                &kp LGUI     &trans       &kp SPACE      &kp SPACE  &trans   &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |  "  |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// |      |     |     |     |     |  '  |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    |    |   |   |   | ENT |     | ALT |
            bindings = <
&kp  TAB   &kp EXCL &kp AT  &kp HASH &kp DLLR &kp PRCNT  &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
&kp LCTRL  &trans   &trans  &trans   &trans   &kp DQT  &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
&trans  &trans   &trans  &trans  &trans  &kp SQT  &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                &trans   &trans   &trans   &kp SPACE   &trans    &trans
            >;
        };

        bt_layer {
            display-name = "BT";
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   |     |     |     |     |     |Studio|
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
            bindings = <
&none   &none  &none  &none  &none  &none   &none   &none   &none &none    &none  &none
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &none &none &none &none &none &studio_unlock
&none   &none  &none  &none  &none  &none  &none   &none   &none &none    &none &none
                &none     &none       &none      &none  &none   &none
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
// -----------------------------------------------------------------------------------------
// |      | SR^  |  M^  | SRv |     |     |   |     |BRI^ |BRIv |     |     |      |
// |      |  M<  |  Mv |  M>  | MCLK|     |   | PP  |VOLv |VOL^ |mute |     |      |
// | RCLK |      |     |      |     |     |   |     |     |     |     |     | SHFT |
//                    |     |     | LCLK |   |    |    |    |
            bindings = <
&none  &msc SCRL_UP  &mmv MOVE_UP &msc SCRL_DOWN &none  &none   &none  &kp C_BRI_UP  &kp C_BRI_DN  &none  &none  &none 
&none  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT  &mkp MCLK   &none  &kp C_PP &kp C_VOL_UP &kp C_VOL_DN  &kp C_MUTE &none &none
&mkp RCLK  &none  &none &none  &none  &none   &none  &none  &none  &none &none  &kp RSHIFT
                &none  &none   &mkp LCLK   &none   &trans  &none 
            >;
        };
    };
};
